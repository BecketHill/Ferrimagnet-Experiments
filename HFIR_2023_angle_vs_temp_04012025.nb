   RowBox[{
    RowBox[{"temp", "=", 
     RowBox[{"N", "[", 
      RowBox[{"data", "[", 
       RowBox[{"[", 
        RowBox[{
         RowBox[{"1", ";;", "49"}], ",", "1"}], "]"}], "]"}], "]"}]}], ";"}], 
   "  ", "\n", 
