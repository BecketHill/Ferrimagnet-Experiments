         RowBox[{"i", " ", "dT"}], ",", 
         RowBox[{
          RowBox[{"rtr", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"i", "+", "1"}], ",", "1"}], "]"}], "]"}], "/", 
          RowBox[{"(", 
           RowBox[{"muB", " ", "NA"}], ")"}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "Tm"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"muat", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"i", " ", "dT"}], ",", 
         RowBox[{
          RowBox[{"rtr", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"i", "+", "1"}], ",", "2"}], "]"}], "]"}], "/", 
          RowBox[{"(", 
           RowBox[{"muB", " ", "NA"}], ")"}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "Tm"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"mudt", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"i", " ", "dT"}], ",", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"rtr", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"i", "+", "1"}], ",", "3"}], "]"}], "]"}]}], "/", 
          RowBox[{"(", 
           RowBox[{"muB", " ", "NA"}], ")"}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "Tm"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"must", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"i", " ", "dT"}], ",", 
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{"rtr", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"i", "+", "1"}], ",", "1"}], "]"}], "]"}], "+", 
            RowBox[{"rtr", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"i", "+", "1"}], ",", "2"}], "]"}], "]"}], "-", 
            RowBox[{"rtr", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"i", "+", "1"}], ",", "3"}], "]"}], "]"}]}], "]"}], "/", 
          RowBox[{"(", 
           RowBox[{"muB", " ", "NA"}], ")"}]}]}], "}"}], ",", 
       RowBox[{"{", 
