      RowBox[{"[", 
       RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "interpolation", "*)"}], 
   RowBox[{
    RowBox[{"musti", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"i", " ", "dT"}], ",", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"rtr", "[", 
